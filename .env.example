# Slack Bot Tokens
# https://api.slack.com/apps 에서 발급

# Bot User OAuth Token (xoxb-로 시작)
# OAuth & Permissions 메뉴에서 확인
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# App-Level Token (xapp-로 시작)
# Basic Information → App-Level Tokens 에서 발급
# Scope: connections:write
SLACK_APP_TOKEN=xapp-your-app-token-here

# Debug 모드 (true/false)
# 메시지 이벤트 상세 로그 출력
DEBUG_MODE=false
